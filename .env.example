# Copy to .env.local. This file contains no credentials.
MODEL_API_KEY=
META_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1

# Development defaults to local files; NODE_ENV=production requires Azure files.
# SQLite is always local and must live on a persistent volume on the VPS.
# MANUAL_DATA_DIR=/data
# NODE_ENV=production
# AZURE_STORAGE_CONNECTION_STRING=  # prefer a SAS connection string scoped to this app's container
# AZURE_STORAGE_CONTAINER=manual-files

# Local development automatically uses the local account. Production requires password auth.
# AUTH_MODE=password
# APP_ORIGIN=https://manual.example.com
# To test real sign-in locally: AUTH_MODE=password APP_ORIGIN=http://localhost:8080
# Create/reset accounts: node scripts/account.mjs <username>
# To assign existing local films to that account, append --claim-local-films (stop server first).

# Job admission (one server process per data directory; all values are positive integers).
# Applies before uploads, revisions, retries, catalogue picks, and saved-example copies.
# MAX_ACTIVE_JOBS=2
# MAX_ACTIVE_JOBS_PER_USER=1
# DAILY_JOBS=100
# DAILY_JOBS_PER_USER=20
# HOURLY_EXAMPLES=120
# HOURLY_EXAMPLES_PER_USER=30
# JOB_TIMEOUT_SECONDS=900
