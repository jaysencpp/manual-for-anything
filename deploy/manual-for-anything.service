# Install as /etc/systemd/system/manual-for-anything.service. Create the first account with scripts/account.mjs before starting.
[Unit]
Description=Manual for Anything
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manual
Group=manual
WorkingDirectory=/opt/manual-for-anything
EnvironmentFile=/etc/manual-for-anything.env
Environment=NODE_ENV=production
Environment=MANUAL_DATA_DIR=/var/lib/manual-for-anything
# Remove --live to serve saved examples only, with no paid model calls.
ExecStart=/usr/bin/node src/server/server.mjs --live --host 127.0.0.1 --port 8080

# One process per data directory. The server stops its own workers on SIGTERM, and allows them 30 seconds.
KillMode=mixed
TimeoutStopSec=45
Restart=on-failure
RestartSec=5

StateDirectory=manual-for-anything
StateDirectoryMode=0700
UMask=0077

# Resource limits. A live job runs a Node worker; raise MemoryMax with MAX_ACTIVE_JOBS.
MemoryMax=4G
TasksMax=512
LimitNOFILE=4096

# Sandboxing. The app writes only to its state directory and its private /tmp file cache.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
